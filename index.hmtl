<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CONGRATULATIONS!!!!!</title>
<style>
    body {
        margin: 0;
        padding: 60px 20px;
        font-family: Arial, sans-serif;
        color: white;
        text-align: center;
        background: black;
        overflow-x: hidden;
    }

    /* Twinkling stars */
    body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 200%;
        height: 200%;
        background: transparent;
        background-image:
            radial-gradient(2px 2px at 20% 30%, white, transparent),
            radial-gradient(1.5px 1.5px at 80% 10%, white, transparent),
            radial-gradient(1px 1px at 50% 80%, white, transparent),
            radial-gradient(2px 2px at 70% 60%, white, transparent),
            radial-gradient(1px 1px at 10% 90%, white, transparent);
        animation: twinkle 6s infinite alternate;
        z-index: -2;
    }

    @keyframes twinkle {
        from { opacity: 0.3; }
        to { opacity: 1; }
    }

    /* Snowfall */
    .snow {
        position: fixed;
        top: -10px;
        color: white;
        font-size: 1em;
        animation: fall linear infinite;
        z-index: -1;
    }

    @keyframes fall {
        to { transform: translateY(110vh); }
    }

    /* Shaking HO HO HO */
    .shake {
        display: inline-block;
        font-weight: 900;
        animation: shake 0.7s infinite;
    }

    @keyframes shake {
        0% { transform: translate(0, 0); }
        25% { transform: translate(-2px, 2px); }
        50% { transform: translate(2px, -2px); }
        75% { transform: translate(-2px, -2px); }
        100% { transform: translate(0, 0); }
    }

    .cosmic {
        font-size: 2.5em;
        font-weight: 900;
        margin: 10px 0;
    }

    .emoji {
        font-size: 1.5em;
    }

    /* Suspense dots and messages */
    .dots {
        font-size: 2.5em;
        letter-spacing: 8px;
        margin: 40px 0;
        opacity: 0.8;
    }

    .suspense {
        font-size: 1.1em;
        font-style: italic;
        opacity: 0.7;
        margin: 20px 0;
    }

    /* Scroll reveal base */
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s ease;
    }

    .reveal.show {
        opacity: 1;
        transform: translateY(0);
    }

    /* Wiggle animation for final dots */
    .wiggle {
        animation: wiggle 1s infinite ease-in-out;
    }

    @keyframes wiggle {
        0% { transform: rotate(0deg); }
        25% { transform: rotate(1deg); }
        50% { transform: rotate(-1deg); }
        75% { transform: rotate(1deg); }
        100% { transform: rotate(0deg); }
    }

    /* Final hype line */
    .final-reveal {
        font-size: 1.5em;
        font-weight: bold;
        margin: 50px 0;
        animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
        0% { opacity: 0.5; }
        50% { opacity: 1; }
        100% { opacity: 0.5; }
    }

    /* Wavy MIGUEL */
    .miguel {
        font-size: 2em;
        font-weight: 900;
        background: linear-gradient(90deg, #ff4ecd, #ffd700, #4dd2ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
        animation: wave 2s infinite ease-in-out;
    }

    @keyframes wave {
        0% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
        100% { transform: translateY(0); }
    }

    /* Photos */
    .photos {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 40px 0;
        flex-wrap: wrap;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 1s ease, transform 1s ease;
    }

    /* Fade in photos individually */
    .photos.show img {
        opacity: 0;
        transform: translateY(20px);
    }

    .photos.show img:nth-child(1) {
        transition: opacity 1s ease 0.2s, transform 1s ease 0.2s;
        opacity: 1;
        transform: translateY(0);
    }
    .photos.show img:nth-child(2) {
        transition: opacity 1s ease 0.6s, transform 1s ease 0.6s;
        opacity: 1;
        transform: translateY(0);
    }
    .photos.show img:nth-child(3) {
        transition: opacity 1s ease 1s, transform 1s ease 1s;
        opacity: 1;
        transform: translateY(0);
    }

    .photos img {
        width: 250px;
        max-width: 90%;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(255,255,255,0.3);
    }

    /* Final info */
    .final {
        margin-top: 50px;
        font-size: 1.2em;
    }

    .otters img {
        margin-top: 30px;
        width: 300px;
        max-width: 90%;
        border-radius: 20px;
    }

    /* Scroll lock */
    .noscroll {
        overflow: hidden;
    }
</style>
</head>
<body>

<h1>
    <span class="shake">HO</span>
    <span class="shake">HO</span>
    <span class="shake">HO!!</span> 🎅✨
</h1>

<p>
    Congratulations! Against all odds, through stardust and tinsel,<br><br>
    <strong>YOU have won the</strong><br>
    <span class="cosmic">COSMIC LOTTERY</span>
    <span class="emoji">🌌🎄</span>
</p>

<p>
    This once-in-a-lifetime prize includes an exclusive, up-close,
    in-person experience with...
</p>

<!-- Suspense messages -->
<div class="reveal dots">. . . . . . . . . .</div>
<p class="reveal suspense">almost there....</p>

<div class="reveal dots">. . . . . . . . . .</div>
<p class="reveal suspense">keep going....</p>

<div class="reveal dots">. . . . . . . . . .</div>
<p class="reveal suspense">any second now....</p>

<div class="reveal dots">. . . . . . . . . .</div>
<p class="reveal suspense">wow this is taking a really long time</p>

<div class="reveal dots wiggle">. . . . . . . . . .</div>
<p class="reveal final-reveal">okay okay — HERE WE GO 👀✨</p>

<p class="reveal"><strong>none other than the legendary</strong><br>
<span class="miguel">MIGUEL</span></p>

<p>Yes — that MIGUEL.</p>

<!-- MIGUEL photos -->
<div class="photos">
    <img src="https://i.scdn.co/image/ab6761610000517435e36c368fdcd26aba296bd1" alt="Miguel 1">
    <img src="https://upload.wikimedia.org/wikipedia/en/4/41/Miguel_Caos.jpg" alt="Miguel 2">
    <img src="https://static.wikia.nocookie.net/disney/images/0/00/Profile_-_Miguel_Rivera.jpg/revision/latest?cb=20190315012208" alt="Miguel 3">
</div>

<p class="reveal">
    Consider this your official notice that the universe, Santa,
    and the stars have all conspired in your favor this Christmas.
    Buckle up… magic awaits! ✨🎶
</p>

<div class="final">
    <p><strong>Date:</strong> FEBRUARY 18, 2026 – 7:30PM</p>
    <p><strong>Location:</strong> HISTORY – 1663 Queen St E, Toronto, ON M4L 1G5</p>

    <h2>🎄 MERRY CHRISTMAS BABE!!! I LOVE YOU 🎄</h2>
</div>

<div class="otters">
    <img src="https://assets3.thrillist.com/v1/image/2559824/1584x1188/scale;webp=auto;jpeg_quality=60.jpg" alt="Otters holding hands">
</div>

<!-- Snow generator -->
<script>
    for (let i = 0; i < 50; i++) {
        let snow = document.createElement("div");
        snow.className = "snow";
        snow.style.left = Math.random() * 100 + "vw";
        snow.style.animationDuration = (5 + Math.random() * 10) + "s";
        snow.style.opacity = Math.random();
        snow.innerHTML = "❄";
        document.body.appendChild(snow);
    }
</script>

<!-- Scroll reveal + scroll lock + photo fade-in -->
<script>
    const reveals = document.querySelectorAll('.reveal');
    const photos = document.querySelector('.photos');

    function revealOnScroll() {
        for (let i = 0; i < reveals.length; i++) {
            const windowHeight = window.innerHeight;
            const elementTop = reveals[i].getBoundingClientRect().top;
            const revealPoint = 100;

            if (elementTop < windowHeight - revealPoint) {
                reveals[i].classList.add('show');
            }
        }

        // Lock scroll 1 second before final reveal
        const finalReveal = document.querySelector('.final-reveal');
        if (finalReveal && !finalReveal.classList.contains('scroll-locked')) {
            const rect = finalReveal.getBoundingClientRect();
            if (rect.top < window.innerHeight / 1.5) {
                document.body.classList.add('noscroll');
                finalReveal.classList.add('scroll-locked');

                setTimeout(() => {
                    document.body.classList.remove('noscroll');
                    // Fade in MIGUEL photos one by one
                    if (photos) {
                        photos.classList.add('show');
                    }
                }, 1000); // 1 second scroll lock
            }
        }
    }

    window.addEventListener('scroll', revealOnScroll);
    revealOnScroll();
</script>

</body>
</html>
